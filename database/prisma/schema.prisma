generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
  REPORTER
}

enum Status {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  VERIFIED
  CLOSED
  REOPENED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Severity {
  COSMETIC
  MINOR
  MODERATE
  MAJOR
  CRITICAL
  BLOCKER
}

enum HistoryAction {
  ISSUE_CREATED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
  SEVERITY_CHANGED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  ISSUE_UPDATED
  ISSUE_RESOLVED
  ISSUE_REOPENED
  ISSUE_CLOSED
}

enum NotificationType {
  ISSUE_ASSIGNED
  STATUS_CHANGED
  COMMENT_ADDED
  MENTION
  SYSTEM
}

enum IncidentStatus {
  DETECTED
  ACKNOWLEDGED
  INVESTIGATING
  MITIGATING
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum EscalationLevel {
  INFO
  WARNING
  HIGH
  CRITICAL
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role            @default(REPORTER)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  refreshTokens       RefreshToken[]
  managedApplications Application[]       @relation("ApplicationOwner")
  managedProjects     Project[]           @relation("ProjectManager")
  reportedIssues      Issue[]             @relation("ReportedIssues")
  assignedIssues      Issue[]             @relation("AssignedIssues")
  comments            Comment[]
  attachments         Attachment[]
  historyChanges      IssueHistory[]
  notifications       Notification[]
  projectMembers      ProjectMember[]
  ownedIncidents      Incident[]          @relation("IncidentOwner")
  timelineActions     IncidentTimeline[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Application {
  id          String      @id @default(uuid())
  name        String
  code        String      @unique
  description String?
  version     String      @default("1.0.0")
  ownerId     String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  owner       User?       @relation("ApplicationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  projects    Project[]
  issues      Issue[]
  incidents   Incident[]

  @@map("applications")
}

model Project {
  id            String          @id @default(uuid())
  applicationId String
  name          String
  key           String          @unique
  description   String?
  status        String          @default("ACTIVE")
  startDate     DateTime?
  endDate       DateTime?
  managerId     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  manager       User?           @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  issues        Issue[]
  members       ProjectMember[]
  incidents     Incident[]

  @@map("projects")
}

model ProjectMember {
  id            String    @id @default(uuid())
  projectId     String
  userId        String
  roleInProject Role      @default(DEVELOPER)
  joinedAt      DateTime  @default(now())

  // Relations
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Issue {
  id               String         @id @default(uuid())
  issueKey         String         @unique
  title            String
  description      String         @db.Text
  applicationId    String
  projectId        String
  moduleComponent  String?
  reporterId       String
  assigneeId       String?
  status           Status         @default(OPEN)
  priority         Priority       @default(MEDIUM)
  severity         Severity       @default(MINOR)
  environment      String?
  stepsToReproduce String?        @db.Text
  expectedResult   String?        @db.Text
  actualResult     String?        @db.Text
  dueDate          DateTime?
  resolution       String?        @db.Text
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relations
  application      Application    @relation(fields: [applicationId], references: [id])
  project          Project        @relation(fields: [projectId], references: [id])
  reporter         User           @relation("ReportedIssues", fields: [reporterId], references: [id])
  assignee         User?          @relation("AssignedIssues", fields: [assigneeId], references: [id])
  comments         Comment[]
  attachments      Attachment[]
  history          IssueHistory[]
  notifications    Notification[]
  incidents        Incident[]

  @@index([status])
  @@index([priority])
  @@index([severity])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([applicationId])
  @@index([projectId])
  @@index([createdAt])
  @@map("issues")
}

model Comment {
  id         String   @id @default(uuid())
  issueId    String
  authorId   String
  content    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id])

  @@index([issueId])
  @@map("comments")
}

model Attachment {
  id           String   @id @default(uuid())
  issueId      String
  uploadedById String
  filename     String
  originalName String
  mimeType     String
  fileSize     Int
  filePath     String
  createdAt    DateTime @default(now())

  // Relations
  issue        Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([issueId])
  @@map("attachments")
}

model IssueHistory {
  id          String        @id @default(uuid())
  issueId     String
  changedById String
  actionType  HistoryAction @default(ISSUE_UPDATED)
  fieldChanged String
  oldValue    String?       @db.Text
  newValue    String?       @db.Text
  createdAt   DateTime      @default(now())

  // Relations
  issue       Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  changedBy   User          @relation(fields: [changedById], references: [id])

  @@index([issueId])
  @@map("issue_history")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  issueId   String?
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue     Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Incident {
  id               String           @id @default(uuid())
  incidentKey      String           @unique
  title            String
  description      String           @db.Text
  projectId        String
  applicationId    String
  moduleComponent  String?
  severity         IncidentSeverity @default(SEV3)
  status           IncidentStatus   @default(DETECTED)
  ownerId          String?
  sourceIssueId    String?
  detectedAt       DateTime         @default(now())
  acknowledgedAt   DateTime?
  investigatingAt  DateTime?
  mitigatingAt     DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  impactSummary    String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project          Project          @relation(fields: [projectId], references: [id])
  application      Application      @relation(fields: [applicationId], references: [id])
  owner            User?            @relation("IncidentOwner", fields: [ownerId], references: [id])
  sourceIssue      Issue?           @relation(fields: [sourceIssueId], references: [id])
  timeline         IncidentTimeline[]

  @@index([projectId])
  @@index([status])
  @@index([severity])
  @@map("incidents")
}

model IncidentTimeline {
  id           String         @id @default(uuid())
  incidentId   String
  actorId      String
  action       String
  oldState     String?
  newState     String?
  metadata     String?        @db.Text
  createdAt    DateTime       @default(now())

  incident     Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor        User           @relation(fields: [actorId], references: [id])

  @@index([incidentId])
  @@map("incident_timelines")
}
