# ==============================================================================
# AITS Enterprise Configuration Environment Template
# ==============================================================================

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=production

# Server Interface & Port (0.0.0.0 binds to all network interfaces for Docker/Cloud)
PORT=5000
HOST=0.0.0.0

# Database Connection (PostgreSQL 14+)
# For Docker Compose: postgresql://postgres:postgres@postgres:5432/app_issue_track?schema=public
# For Local Dev:      postgresql://postgres:postgres@localhost:5432/app_issue_track?schema=public
# For Cloud Managed:  postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_issue_track?schema=public"

# Database Container Configuration (Used by Docker Compose)
POSTGRES_DB=app_issue_track
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Security & Authentication
# IMPORTANT: Generate a high-entropy string in production (e.g. openssl rand -base64 32)
JWT_SECRET=super-secret-jwt-key-replace-in-production-minimum-32-chars
JWT_EXPIRES_IN=1d

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed web origins (e.g. https://aits.yourcompany.com)
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost

# AI Copilot & Automated Intelligence (Optional)
AI_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
AI_RATE_LIMIT_PER_MIN=10

# Frontend Configuration
# Leave blank when using Docker/Nginx reverse proxy (defaults to relative /api/v1)
# Set to full URL if hosting frontend on separate domain (e.g. https://api.yourdomain.com/api/v1)
VITE_API_BASE_URL=
FRONTEND_PORT=5173
BACKEND_PORT=5000

