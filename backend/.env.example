NODE_ENV=development
PORT=5000
HOST=localhost
DATABASE_URL="postgresql://postgres:password@localhost:5432/app_issue_track?schema=public"
JWT_SECRET=super-secret-jwt-key-replace-in-production-minimum-32-chars
JWT_EXPIRES_IN=1d
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
CORS_ORIGIN=http://localhost:5173

# Google Gemini AI Intelligence Configuration
AI_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=your-google-gemini-api-key-here
AI_RATE_LIMIT_PER_MIN=10
